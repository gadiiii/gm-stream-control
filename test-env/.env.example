# Copy to test-env/.env and fill in. Never commit .env.
#
# This MUST point at a staging Supabase project, not the one your services use.
# seed.py deletes every destination in the target project, and verify.py
# deliberately corrupts a stream key to test the failure path.

SUPABASE_URL=https://your-staging-project.supabase.co
# service_role key (sb_secret_...) — NOT the anon/publishable key
SUPABASE_KEY=your-staging-service-role-key

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Use a DIFFERENT key from production. Keys encrypted with one cannot be read
# with the other, which is the point.
ENCRYPTION_KEY=

# A user created in the staging project. verify.py signs in as this user so it
# exercises the real auth path rather than bypassing it.
SUPABASE_TEST_EMAIL=test@example.com
SUPABASE_TEST_PASSWORD=

# Required acknowledgement. seed.py refuses to run without it.
I_KNOW_THIS_IS_STAGING=yes
