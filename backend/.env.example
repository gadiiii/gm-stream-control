# Copy this file to .env and fill in your values.
# Never commit .env — it contains secrets.

# Supabase — from your project's Settings > API
SUPABASE_URL=https://your-project.supabase.co
# service_role key (sb_secret_...) — NOT the anon/publishable key
SUPABASE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Nginx-RTMP LXC (change to your LXC IP in production)
RTMP_STAT_URL=http://localhost:8080/stat
NGINX_CONFIG_PATH=/etc/nginx/nginx.conf

# Frontend origin(s) for CORS — comma-separated for multiple (e.g. local + Tailscale)
FRONTEND_ORIGIN=http://localhost:3000

# Shared secret injected by a Cloudflare Transform Rule. When set, requests that
# don't carry it are rejected — blocks anyone bypassing the tunnel.
CF_TUNNEL_SECRET=

# Bitfocus Companion. COMPANION_API_KEY guards /api/companion/*; the button
# values are "page/row/column" (e.g. 1/0/2) pressed when going live/stopping.
COMPANION_API_KEY=
COMPANION_URL=http://192.168.4.20:8000
COMPANION_BUTTON_GOLIVE=
COMPANION_BUTTON_STOP=

# Phase 4: Platform APIs (not required for v1)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

